# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is in .gitignore, so it never ends up on GitHub.

aws_region       = "eu-central-1"
instance_type    = "t3.micro"
allowed_ssh_cidr = "203.0.113.10/32" # your IP: run `curl -s https://checkip.amazonaws.com` and add /32
ssh_public_key   = "ssh-ed25519 AAAA... you@laptop" # contents of ~/.ssh/iac-lab.pub
